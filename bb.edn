{:paths ["src" "scripts"]

 :deps {babashka/process {:mvn/version "0.6.25"}}

 :tasks
 {test {:doc "Run tests"
        :task (shell "bin/clj-test -M:test")}

  repl {:doc "Start a scratch dev nREPL on an OS-assigned port (never 7910)"
        :task (shell "clojure -M:dev-repl")}

  ;; The SERVING image. This boots hive-mcp.server.core, whose :hive/nrepl
  ;; component binds HIVE_MCP_NREPL_PORT (default 7910) — the port bb-mcp
  ;; forwards tool calls to. Naming this task is the explicit act; `bb repl`
  ;; must never land here by accident.
  serve {:doc "Start the hive-mcp SERVER (binds the serving nREPL port)"
         :task (shell "clojure -M:nrepl")}

  install-unit {:doc "Install resources/systemd/hive-mcp.service as a systemd user unit and daemon-reload; never enables or starts it (--dry-run)"
                :task (apply (requiring-resolve 'hive-mcp.service.install/-main) *command-line-args*)}

  mcp {:doc "Start MCP server"
       :task (shell "clojure -X:mcp")}

  diagram-deps {:doc "Check/install diagram dependencies (plantuml, graphviz, overarch)"
                :task (exec 'diagram-deps/-main)}}}
