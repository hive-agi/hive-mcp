{:paths ["src" "scripts"]

 ;; malli and test.check are here for `test:launch` only: hive-mcp.launch.*
 ;; (the :launch config schema, its defaults and the env-knob table) is plain
 ;; data plus total parsers, and it must stay runnable and testable with NO
 ;; JVM and no server, so a schema edit is checked in a second rather than a
 ;; cold clojure -M:test-unit. malli works under babashka; both are on the JVM
 ;; classpath already (metosin/malli in deps.edn :deps, test.check on :test*).
 :deps {babashka/process {:mvn/version "0.6.25"}
        metosin/malli {:mvn/version "0.20.2"}
        org.clojure/test.check {:mvn/version "1.1.3"}}

 :tasks
 ;; :extra-paths is scoped to THIS task on purpose: the :launch tests must not
 ;; widen the classpath of `bb test`, `bb serve` or any other task, which load
 ;; src alone.
 {test:launch {:doc "Test the :launch config layer only (schema, defaults, env knobs) under babashka; no JVM, no server. Exits non-zero on failure"
               :extra-paths ["test"]
               :task (exec 'hive-mcp.launch.test-runner/-main)}

  test {:doc "Run tests"
        :task (shell "bin/clj-test -M:test")}

  repl {:doc "Start a scratch dev nREPL on an OS-assigned port (never 7910)"
        :task (shell "clojure -M:dev-repl")}

  ;; The SERVING image. This boots hive-mcp.server.core, whose :hive/nrepl
  ;; component binds HIVE_MCP_NREPL_PORT (default 7910) — the port bb-mcp
  ;; forwards tool calls to. Naming this task is the explicit act; `bb repl`
  ;; must never land here by accident.
  serve {:doc "Start the hive-mcp SERVER (binds the serving nREPL port)"
         :task (shell "clojure -M:nrepl")}

  install-unit {:doc "Install resources/systemd/hive-mcp.service as a systemd user unit and daemon-reload; never enables or starts it (--dry-run)"
                :task (apply (requiring-resolve 'hive-mcp.service.install/-main) *command-line-args*)}

  mcp {:doc "Start MCP server"
       :task (shell "clojure -X:mcp")}

  diagram-deps {:doc "Check/install diagram dependencies (plantuml, graphviz, overarch)"
                :task (exec 'diagram-deps/-main)}}}
