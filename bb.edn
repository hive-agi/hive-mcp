{;; "resources" is on the path so `bb test:launch` resolves the preset
 ;; resources (resources/hive_mcp/launch/presets/*.edn) and the repo's
 ;; starter.deps.edn through io/resource, the same lookup the JVM uses.
 :paths ["src" "scripts" "resources"]

 ;; malli and test.check: for `test:launch` (metosin/malli is also in deps.edn,
 ;; test.check on :test*).
 :deps {babashka/process {:mvn/version "0.6.25"}
        metosin/malli {:mvn/version "0.20.2"}
        org.clojure/test.check {:mvn/version "1.1.3"}
        ;; Pinned to the version the root deps.edn pins. Without this, bb
        ;; resolves Clojure transitively and can land on a version whose jar a
        ;; cold Maven cache cannot serve, which failed CI's launch job once.
        org.clojure/clojure {:mvn/version "1.12.6"}}

 :tasks
 ;; :extra-paths is scoped to this task; other tasks load src alone.
 {test:launch {:doc "Test the :launch config layer (schema, defaults, env knobs, deps overlay) under babashka; no JVM, no server. Exits non-zero on failure"
               :extra-paths ["test"]
               :task (exec 'hive-mcp.launch.test-runner/-main)}

  launch:import {:doc "Print the :launch fragment for a local.deps.edn path as EDN on stdout; writes nothing. Reads no other file."
                 :task (apply (requiring-resolve 'hive-mcp.launch.importer/-main) *command-line-args*)}

  test {:doc "Run tests"
        :task (shell "bin/clj-test -M:test")}

  repl {:doc "Start a scratch dev nREPL on an OS-assigned port (never 7910)"
        :task (shell "clojure -M:dev-repl")}

  ;; The SERVING image. This boots hive-mcp.server.core, whose :hive/nrepl
  ;; component binds HIVE_MCP_NREPL_PORT (default 7910) — the port bb-mcp
  ;; forwards tool calls to. Naming this task is the explicit act; `bb repl`
  ;; must never land here by accident.
  serve {:doc "Start the hive-mcp SERVER (binds the serving nREPL port)"
         :task (shell "clojure -M:nrepl")}

  install-unit {:doc "Install resources/systemd/hive-mcp.service as a systemd user unit and daemon-reload; never enables or starts it (--dry-run)"
                :task (apply (requiring-resolve 'hive-mcp.service.install/-main) *command-line-args*)}

  mcp {:doc "Start MCP server"
       :task (shell "clojure -X:mcp")}

  diagram-deps {:doc "Check/install diagram dependencies (plantuml, graphviz, overarch)"
                :task (exec 'diagram-deps/-main)}}}
