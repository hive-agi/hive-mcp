;; clj-kondo config exported by hive-mcp.
;;
;; SINGLE SOURCE: every hook below points at hive-dsl's own exported hooks
;; (hive-dsl.hooks.*), which hive-dsl ships under its clj-kondo export and a
;; consumer already imports transitively. hive-mcp.dns.result is a pure
;; re-export shim of hive-dsl.result (src/hive_mcp/dns/result.clj), so a
;; second hook implementation here was always a copy that could drift — and it
;; did: this file and .clj-kondo/config.edn mapped the same call to two
;; different namespaces, so the repo linted through one while every consumer
;; received the other, and neither was checked against the other.
;;
;; The local duplicate (hive-mcp.hooks.result) is deleted. Keep this file and
;; .clj-kondo/config.edn in agreement; hive-mcp.kondo.config-export-test fails
;; the build when their :hooks/:analyze-call keys disagree.
{:lint-as
 {hive-mcp.tools.memory.core/with-entry clojure.core/let}

 :hooks
 {:analyze-call
  {hive-mcp.tools.core/with-coerced-params hive-mcp.hooks.tools/with-coerced-params
   hive-mcp.dns.result/let-ok              hive-dsl.hooks.result/let-ok
   hive-mcp.dns.result/try-effect          hive-dsl.hooks.result/try-effect
   hive-mcp.dns.result/try-effect*         hive-dsl.hooks.result/try-effect*
   hive-mcp.dns.result/rescue              hive-dsl.hooks.result/rescue
   hive-mcp.dns.result/guard               hive-dsl.hooks.result/guard
   hive-mcp.dns.result/rescue-log          hive-dsl.hooks.result/rescue-log
   hive-mcp.dns.result/rescue-interrupt    hive-dsl.hooks.result/rescue-interrupt
   hive-mcp.dns.result/ok->                hive-dsl.hooks.macros/ok->
   hive-mcp.dns.result/ok->>               hive-dsl.hooks.macros/ok->>}}}
