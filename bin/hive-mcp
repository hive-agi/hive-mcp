#!/usr/bin/env bash
# hive-mcp startup script
#
# Usage:
#   bin/hive-mcp                     # desktop profile (default)
#   bin/hive-mcp --profile k8s-headless
#   HIVE_PROFILE=k8s-minimal bin/hive-mcp
#   HIVE_MCP_CONFIG=~/.config/hive-mcp/bare.edn bin/hive-mcp   # a second config.edn
#
# Env knobs: HIVE_MCP_XMX (10g) HIVE_MCP_XMS (2g) HIVE_MCP_SOFT_MAX_HEAP (8g)
#            MALLOC_ARENA_MAX (4) HIVE_MCP_SUPERVISE (1: restart on OOM kill)
#            HIVE_MCP_MAX_RESTARTS (5) HIVE_MCP_RESTART_WINDOW (600s)
#            HIVE_MCP_OOM_SCORE_ADJ (-500) HIVE_MCP_OOMD_PREFERENCE (avoid)
#            HIVE_MCP_COREDUMP (0: 1 raises ulimit -c for crash forensics)
#
# Profile precedence: --profile flag > HIVE_PROFILE env > config.edn
# [:system :profile] > "desktop". Unset here means config.edn decides.
#
# Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Profile resolution ──────────────────────────────────────────────
# Parse --profile flag from args (consume it, pass rest to clj)
PROFILE="${HIVE_PROFILE:-}"
PASSTHROUGH_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="${2:?'--profile requires a value (desktop, k8s-headless, k8s-minimal)'}"
      shift 2
      ;;
    --profile=*)
      PROFILE="${1#*=}"
      shift
      ;;
    *)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$PROFILE" ]]; then
  export HIVE_PROFILE="$PROFILE"
  echo "hive-mcp: profile=$HIVE_PROFILE" >&2
else
  unset HIVE_PROFILE
  echo "hive-mcp: profile from config.edn [:system :profile], else desktop" >&2
fi

# ── Local deps overlay ──────────────────────────────────────────────
# Merge local.deps.edn (gitignored) via -Sdeps for sibling :local/root overrides.
# The filename is local.deps.edn — matching .gitignore and the deps.edn comment.
# (It was previously spelled deps.local.edn here, so the overlay never fired.)
#
# Must be a bash ARRAY: the EDN payload contains spaces, and an unquoted
# "$SDEPS_ARG" scalar word-splits it into separate argv entries, so clj would
# receive `-Sdeps` `{:deps` `{io.github…` and fail to read the map.
SDEPS_ARG=()
if [[ -f "$PROJECT_DIR/local.deps.edn" ]]; then
  SDEPS_ARG=(-Sdeps "$(cat "$PROJECT_DIR/local.deps.edn")")
  echo "hive-mcp: merging local.deps.edn"
fi

# ── AOT boot classes (opt-in) ───────────────────────────────────────
# HIVE_FAST_BOOT=1 puts target/boot-classes on the classpath, so the addon
# constructor namespaces load as .class files instead of being compiled at
# boot. Build them with:
#
#   clojure -Sdeps "$(cat local.deps.edn)" -X:aot-boot
#
# Clojure loads a .class only when it is newer than its .clj, so a partly
# stale directory boots a MIXED image — edited namespaces from source, the
# protocols they were compiled against from class files. Staleness therefore
# DECLINES the optimization instead of warning past it: the env var asks for
# a faster boot, never for a different program.
ALIASES=":mcp"
STAMP="$PROJECT_DIR/target/boot-classes/.aot-stamp.edn"

fast_boot_requested() {
  [[ "${HIVE_FAST_BOOT:-}" == "1" || "${HIVE_FAST_BOOT:-}" == "true" ]]
}

source_newer_than() {
  find "$PROJECT_DIR/src" "$PROJECT_DIR"/../*/src -type f \
       \( -name '*.clj' -o -name '*.cljc' \) -newer "$1" -print -quit 2>/dev/null
}

if fast_boot_requested; then
  if [[ ! -f "$STAMP" ]]; then
    echo "hive-mcp: HIVE_FAST_BOOT set but no AOT classes — booting from source"
    echo "hive-mcp:   build them: clojure -Sdeps \"\$(cat local.deps.edn)\" -X:aot-boot"
  else
    STALE="$(source_newer_than "$STAMP" || true)"
    if [[ -n "$STALE" ]]; then
      echo "hive-mcp: AOT classes are stale ($STALE is newer) — booting from source"
      echo "hive-mcp:   rebuild them: clojure -Sdeps \"\$(cat local.deps.edn)\" -X:aot-boot"
    else
      ALIASES=":mcp:fast-boot"
      echo "hive-mcp: fast boot — AOT classes from target/boot-classes"
    fi
  fi
fi

# ── Memory budget ───────────────────────────────────────────────────
# -J flags land after the alias :jvm-opts; the JVM honours the last one.
# RSS ~= heap + 1.5-2.5 GB native (metaspace, threads, malloc arenas).
HIVE_MCP_XMX="${HIVE_MCP_XMX:-10g}"
HIVE_MCP_XMS="${HIVE_MCP_XMS:-2g}"
HIVE_MCP_SOFT_MAX_HEAP="${HIVE_MCP_SOFT_MAX_HEAP:-8g}"
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-4}"

JVM_ARGS=(-J-Xmx"$HIVE_MCP_XMX" -J-Xms"$HIVE_MCP_XMS"
          -J-XX:SoftMaxHeapSize="$HIVE_MCP_SOFT_MAX_HEAP")

# ── Crash forensics ─────────────────────────────────────────────────
# A native crash (SIGSEGV) leaves hs_err_pid<pid>.log in the project dir, but
# a core dump only when the core limit is non-zero; most shells default to 0.
# HIVE_MCP_COREDUMP=1 raises the soft limit as far as the hard limit allows,
# for this JVM only. Cores go wherever /proc/sys/kernel/core_pattern says
# (systemd-coredump: `coredumpctl list java`).
if [[ "${HIVE_MCP_COREDUMP:-0}" == "1" ]]; then
  ulimit -c "$(ulimit -H -c)" 2>/dev/null || true
  echo "hive-mcp: core dumps enabled (ulimit -c $(ulimit -c))" >&2
fi
JVM_ARGS+=(-J-XX:+CreateCoredumpOnCrash)

# ── OOM standing: the server outlives a runaway test JVM ────────────
# Kernel OOM killer: try to lower our oom_score_adj (inherited by the JVM).
# Lowering needs CAP_SYS_RESOURCE; unprivileged it stays put and test JVMs
# raise theirs instead (bin/test-sandboxed.sh). systemd-oomd ignores the adj
# and kills whole cgroups, so the JVM also runs in its own user scope with
# ManagedOOMPreference=avoid. Knobs: HIVE_MCP_OOM_SCORE_ADJ (-500),
# HIVE_MCP_OOMD_PREFERENCE (avoid|omit|none, "off" = no scope).
# Proof: bin/oom-policy.sh check <jvm-pid>. See bin/oom-policy.sh.
# shellcheck source=bin/oom-policy.sh
source "$SCRIPT_DIR/oom-policy.sh"
oom_adj_set "${HIVE_MCP_OOM_SCORE_ADJ:--500}"
OOMD_PREF="${HIVE_MCP_OOMD_PREFERENCE:-avoid}"

# :mcp carries :exec-fn and no :main-opts, so -M needs an explicit -m.
CMD=(clojure "${JVM_ARGS[@]}" "${SDEPS_ARG[@]+"${SDEPS_ARG[@]}"}" -M"$ALIASES"
     -m hive-mcp.server.core "${PASSTHROUGH_ARGS[@]+"${PASSTHROUGH_ARGS[@]}"}")

# ── Launch ──────────────────────────────────────────────────────────
cd "$PROJECT_DIR"

if [[ "${HIVE_MCP_SUPERVISE:-1}" != "1" ]]; then
  # One launch, so one scope; oom_scope_prefix has just started a real probe
  # scope, so a start failure here would need the user manager to vanish in
  # between. exec keeps the pid, which is what an unsupervised caller wants.
  OOM_SCOPE_PREFIX=()
  [[ "$OOMD_PREF" != "off" ]] && oom_scope_prefix hive-mcp "$OOMD_PREF"
  exec ${OOM_SCOPE_PREFIX[@]+"${OOM_SCOPE_PREFIX[@]}"} "${CMD[@]}"
fi

# Restart after an OOM death (137 = SIGKILL, 3 = -XX:+ExitOnOutOfMemoryError).
# Each launch builds its own scope: the dead JVM's scope can stay loaded while
# its orphaned children live, and a reused unit name would fail to start.
# The child keeps this shell's stdin (the stdio MCP transport).
OOM_MAX_RESTARTS="${HIVE_MCP_MAX_RESTARTS:-5}"
OOM_RESTART_WINDOW="${HIVE_MCP_RESTART_WINDOW:-600}"
set +e
oom_supervise hive-mcp "$OOMD_PREF" "${CMD[@]}"
exit $?
