#!/usr/bin/env bash
# hive-mcp startup script
#
# Usage:
#   bin/hive-mcp                     # desktop profile (default)
#   bin/hive-mcp --profile k8s-headless
#   HIVE_PROFILE=k8s-minimal bin/hive-mcp
#
# Env knobs: HIVE_MCP_XMX (10g) HIVE_MCP_XMS (2g) HIVE_MCP_SOFT_MAX_HEAP (8g)
#            MALLOC_ARENA_MAX (4) HIVE_MCP_SUPERVISE (1: restart on OOM kill)
#            HIVE_MCP_MAX_RESTARTS (5) HIVE_MCP_RESTART_WINDOW (600s)
#
# Profile precedence: --profile flag > HIVE_PROFILE env > "desktop"
#
# Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Profile resolution ──────────────────────────────────────────────
# Parse --profile flag from args (consume it, pass rest to clj)
PROFILE="${HIVE_PROFILE:-desktop}"
PASSTHROUGH_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="${2:?'--profile requires a value (desktop, k8s-headless, k8s-minimal)'}"
      shift 2
      ;;
    --profile=*)
      PROFILE="${1#*=}"
      shift
      ;;
    *)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
  esac
done

export HIVE_PROFILE="$PROFILE"

echo "hive-mcp: profile=$HIVE_PROFILE"

# ── Local deps overlay ──────────────────────────────────────────────
# Merge local.deps.edn (gitignored) via -Sdeps for sibling :local/root overrides.
# The filename is local.deps.edn — matching .gitignore and the deps.edn comment.
# (It was previously spelled deps.local.edn here, so the overlay never fired.)
#
# Must be a bash ARRAY: the EDN payload contains spaces, and an unquoted
# "$SDEPS_ARG" scalar word-splits it into separate argv entries, so clj would
# receive `-Sdeps` `{:deps` `{io.github…` and fail to read the map.
SDEPS_ARG=()
if [[ -f "$PROJECT_DIR/local.deps.edn" ]]; then
  SDEPS_ARG=(-Sdeps "$(cat "$PROJECT_DIR/local.deps.edn")")
  echo "hive-mcp: merging local.deps.edn"
fi

# ── AOT boot classes (opt-in) ───────────────────────────────────────
# HIVE_FAST_BOOT=1 puts target/boot-classes on the classpath, so the addon
# constructor namespaces load as .class files instead of being compiled at
# boot. Build them with:
#
#   clojure -Sdeps "$(cat local.deps.edn)" -X:aot-boot
#
# Clojure loads a .class only when it is newer than its .clj, so a partly
# stale directory boots a MIXED image — edited namespaces from source, the
# protocols they were compiled against from class files. Staleness therefore
# DECLINES the optimization instead of warning past it: the env var asks for
# a faster boot, never for a different program.
ALIASES=":mcp"
STAMP="$PROJECT_DIR/target/boot-classes/.aot-stamp.edn"

fast_boot_requested() {
  [[ "${HIVE_FAST_BOOT:-}" == "1" || "${HIVE_FAST_BOOT:-}" == "true" ]]
}

source_newer_than() {
  find "$PROJECT_DIR/src" "$PROJECT_DIR"/../*/src -type f \
       \( -name '*.clj' -o -name '*.cljc' \) -newer "$1" -print -quit 2>/dev/null
}

if fast_boot_requested; then
  if [[ ! -f "$STAMP" ]]; then
    echo "hive-mcp: HIVE_FAST_BOOT set but no AOT classes — booting from source"
    echo "hive-mcp:   build them: clojure -Sdeps \"\$(cat local.deps.edn)\" -X:aot-boot"
  else
    STALE="$(source_newer_than "$STAMP" || true)"
    if [[ -n "$STALE" ]]; then
      echo "hive-mcp: AOT classes are stale ($STALE is newer) — booting from source"
      echo "hive-mcp:   rebuild them: clojure -Sdeps \"\$(cat local.deps.edn)\" -X:aot-boot"
    else
      ALIASES=":mcp:fast-boot"
      echo "hive-mcp: fast boot — AOT classes from target/boot-classes"
    fi
  fi
fi

# ── Memory budget ───────────────────────────────────────────────────
# -J flags land after the alias :jvm-opts; the JVM honours the last one.
# RSS ~= heap + 1.5-2.5 GB native (metaspace, threads, malloc arenas).
HIVE_MCP_XMX="${HIVE_MCP_XMX:-10g}"
HIVE_MCP_XMS="${HIVE_MCP_XMS:-2g}"
HIVE_MCP_SOFT_MAX_HEAP="${HIVE_MCP_SOFT_MAX_HEAP:-8g}"
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-4}"

JVM_ARGS=(-J-Xmx"$HIVE_MCP_XMX" -J-Xms"$HIVE_MCP_XMS"
          -J-XX:SoftMaxHeapSize="$HIVE_MCP_SOFT_MAX_HEAP")

# :mcp carries :exec-fn and no :main-opts, so -M needs an explicit -m.
CMD=(clojure "${JVM_ARGS[@]}" "${SDEPS_ARG[@]}" -M"$ALIASES"
     -m hive-mcp.server.core "${PASSTHROUGH_ARGS[@]}")

# ── Launch ──────────────────────────────────────────────────────────
cd "$PROJECT_DIR"

# 137 = SIGKILL (kernel OOM-killer), 3 = -XX:+ExitOnOutOfMemoryError.
restartable_exit() { [[ "$1" == 137 || "$1" == 3 ]]; }

if [[ "${HIVE_MCP_SUPERVISE:-1}" != "1" ]]; then
  exec "${CMD[@]}"
fi

MAX_RESTARTS="${HIVE_MCP_MAX_RESTARTS:-5}"
RESTART_WINDOW="${HIVE_MCP_RESTART_WINDOW:-600}"
restarts=()
child=""
trap '[[ -n "$child" ]] && kill -TERM "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 143' INT TERM

while true; do
  "${CMD[@]}" &
  child=$!
  set +e
  wait "$child"
  code=$?
  set -e
  child=""
  if ! restartable_exit "$code"; then
    exit "$code"
  fi
  now=$SECONDS
  recent=()
  for t in "${restarts[@]}"; do
    (( now - t < RESTART_WINDOW )) && recent+=("$t")
  done
  restarts=("${recent[@]}" "$now")
  if (( ${#restarts[@]} > MAX_RESTARTS )); then
    echo "hive-mcp: exit $code, $MAX_RESTARTS restarts within ${RESTART_WINDOW}s, giving up" >&2
    exit "$code"
  fi
  echo "hive-mcp: exit $code (OOM) at $(date -Is), restart ${#restarts[@]}/$MAX_RESTARTS in 5s" >&2
  sleep 5
done
