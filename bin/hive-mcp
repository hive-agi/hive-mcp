#!/usr/bin/env bash
# hive-mcp launcher: a thin shim around the bb launcher (hive-mcp.launch.main).
#
# The plan, the config precedence and the effect order live there; this file
# only finds the checkout, insists on `bb`, and execs. `exec` keeps the pid, so
# the JVM (and the supervised child) is this script's pid, which is what a
# caller signalling the launcher expects.
#
# stdout is NEVER written here: it is the stdio JSON-RPC channel.
#
# Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v bb >/dev/null 2>&1; then
  echo "hive-mcp: bb (babashka) is not on PATH; see https://babashka.org" >&2
  exit 127
fi
exec bb --config "$DIR/../bb.edn" -m hive-mcp.launch.main "$@"
