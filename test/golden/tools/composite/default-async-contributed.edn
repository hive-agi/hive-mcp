{:case-0 {:out #{}, :in {carto {:default-async false}}},
 :case-1
 {:out #{:agent run},
  :in
  {:kg {:default-async nil},
   :agent {:default-async [:run]},
   carto {:default-async nil}}},
 :case-2
 {:out #{:kg list :carto list :memory :kg scan :carto run},
  :in
  {"memory" {:default-async true},
   :kg {:default-async #{"scan" list}},
   :agent {:default-async false},
   carto {:default-async #{:run list}}}},
 :case-3
 {:out #{},
  :in
  {:kg {:default-async nil},
   "memory" {:default-async false},
   :agent {:default-async false}}},
 :case-4
 {:out #{:memory list :agent list :memory scan :agent scan :agent run},
  :in
  {"memory" {:default-async [list "scan"]},
   :agent {:default-async #{:run "scan" list}}}},
 :case-5
 {:out #{:carto scan :carto list :kg run :carto run},
  :in
  {carto {:default-async #{:run "scan" list}},
   :kg {:default-async #{:run}}}},
 :case-6
 {:out #{},
  :in {:agent {:default-async nil}, carto {:default-async nil}}},
 :case-7
 {:out #{:kg scan},
  :in {:kg {:default-async #{"scan"}}, carto {:default-async false}}}}
