    :content "hello",
    :data "payload"}},
  :in
  ({:type :saa-complete,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload"}
   :abstract)},
 :case-2
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :abstract,
   :content
   {:type :tool-use,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload",
    :message "bad"}},
  :in
  ({:type :tool-use,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload",
    :message "bad"}
   nil)},
 :case-3
 {:out
  {:adt/variant :pm/error,
   :adt/type :PhaseMessage,
   :phase :act,
   :error "bad"},
