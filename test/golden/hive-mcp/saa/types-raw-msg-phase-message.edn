{:case-0
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :abstract,
   :content
   {:type :tool-use,
    :saa-phase :abstract,
    :error "boom",
    :message "bad"}},
  :in
  ({:type :tool-use,
    :saa-phase :abstract,
    :error "boom",
    :message "bad"}
   nil)},
 :case-1
 {:out
