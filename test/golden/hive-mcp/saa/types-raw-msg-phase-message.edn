{:case-0
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :abstract,
   :content nil},
  :in
  ({:type :message,
    :saa-phase :abstract,
    :error "boom",
    :message "bad"}
   nil)},
 :case-1
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :abstract,
   :content
   {:type :tool-use,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload"}},
  :in
  ({:type :tool-use,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload"}
   :abstract)},
 :case-2
 {:out
  {:adt/variant :pm/error,
   :adt/type :PhaseMessage,
   :phase :abstract,
   :error "bad"},
  :in
  ({:type :error,
    :phase :act,
    :saa-phase :abstract,
    :content "hello",
    :data "payload",
    :message "bad"}
   nil)},
 :case-3
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :act,
   :content "done"},
  :in
  ({:type :message, :phase :act, :content "done", :message "bad"}
   :act)},
 :case-4
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase nil,
   :content {:content "done", :error "boom"}},
  :in ({:content "done", :error "boom"} nil)},
 :case-5
 {:out
  {:adt/variant :pm/chunk,
   :adt/type :PhaseMessage,
   :phase :silence,
   :content {:type :tool-use, :phase :silence}},
  :in ({:type :tool-use, :phase :silence} nil)},
 :case-6
 {:out
  {:adt/variant :pm/phase-complete,
   :adt/type :PhaseMessage,
   :phase nil,
   :payload "hello"},
  :in ({:type :complete, :content "hello", :message "bad"} nil)},
 :case-7
 {:out
  {:adt/variant :pm/saa-complete,
   :adt/type :PhaseMessage,
   :summary {:saa-phase :abstract, :error "boom"}},
  :in ({:type :saa-complete, :saa-phase :abstract, :error "boom"} nil)}}
